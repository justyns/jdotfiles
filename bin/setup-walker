#!/usr/bin/env bash
# Install and configure walker + elephant

set -euo pipefail

DOTFILES_DIR="${HOME}/.jdotfiles"
WALKER_CONFIG="${HOME}/.config/walker"

source "${DOTFILES_DIR}/bash/colors"
source "${DOTFILES_DIR}/bash/helpers"

PACKAGES=(
  walker
  elephant
  elephant-menus
  elephant-providerlist
  elephant-desktopapplications
  elephant-calc
  elephant-symbols
  elephant-unicode
  elephant-files
  elephant-clipboard
)

ELEPHANT_CONFIG="${HOME}/.config/elephant"

hash pacman 2>/dev/null || fail "Not an Arch-based system"
hash yay 2>/dev/null || fail "yay is required to install the AUR packages"
[ -d "$WALKER_CONFIG" ] || fail "$WALKER_CONFIG missing - run install.sh first"
[ -d "$ELEPHANT_CONFIG" ] || fail "$ELEPHANT_CONFIG missing - run install.sh first"

info "Installing walker, elephant and providers"
yay -S --needed "${PACKAGES[@]}"

# TODO: Use a shared helper
link() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    warn "$dest exists and is not a symlink, skipping"
    return
  fi
  ln -sfn "$src" "$dest"
  success "$dest -> $src"
}

link "${WALKER_CONFIG}/walker.service" "${HOME}/.config/systemd/user/walker.service"
for desktop in "${WALKER_CONFIG}"/walker*.desktop; do
  link "$desktop" "${HOME}/.local/share/applications/$(basename "$desktop")"
done

info "Enabling services"
elephant service enable
systemctl --user daemon-reload
systemctl --user enable --now elephant.service walker.service

if [ "${XDG_CURRENT_DESKTOP:-}" = "KDE" ]; then
  # Each .desktop declares its binding in X-KDE-Shortcuts. kglobalaccel reads
  # those as defaults once kbuildsycoca6 has indexed the files
  info "Registering shortcuts in Plasma"
  kbuildsycoca6 >/dev/null 2>&1
  systemctl --user restart plasma-kglobalaccel.service
else
  warn "Not a Plasma session, need to configure these shortcuts some other way"
  grep -H '^Exec=\|^X-KDE-Shortcuts=' "${WALKER_CONFIG}"/walker*.desktop
fi

info "Done. Press Meta+Space, or run 'walker' to test."
