#!/usr/bin/env bash
# tmux-agent - tmux status bar and fzf picker for Claude, Codex, and other agents
#
#   tmux-agent pick                 fzf picker over agent panes, jumps on enter
#   tmux-agent list                 same rows, plain text
#   tmux-agent summary              one compact line for the tmux status bar
#   tmux-agent clean                drop state for panes that no longer exist
#   tmux-agent set <state> [msg]    record this pane's state (called by hooks)
#   tmux-agent codex-notify <json>  codex notify entrypoint (payload in argv)
#
#   claude  ~/.claude/settings.json   UserPromptSubmit->running Notification->waiting
#                                     Stop->idle SessionEnd->gone
#   codex   ~/.codex/hooks.json       same, prefixed TMUX_AGENT_TAG=cx, with
#                                     PermissionRequest->waiting instead, plus
#                                     notify = ["<abs path>","codex-notify"] in
#                                     config.toml

set -uo pipefail

STATE_DIR="${TMUX_AGENT_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/tmux-agent}"
AGENT_RE="${TMUX_AGENT_CMD_RE:-^(claude|codex|aider|gemini|opencode|crush|goose|cursor-agent|amp|q)$}"
AGENT_ARGV_RE="${TMUX_AGENT_ARGV_RE:-(^|/)(codex|claude|aider|opencode|crush|goose|amp|cursor-agent)( |$)}"

# Lets the whole tool point at a non-default tmux server (tmux -L foo)
read -r -a TMUX_CMD <<<"${TMUX_AGENT_TMUX:-tmux}"

SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")

die() { printf 'tmux-agent: %s\n' "$*" >&2; exit 1; }

# Two of these because the socket name has two sources: writers use $TMUX, which
# names the server the agent is running in and costs no fork; readers have to
# ask, since TMUX_CMD may point at a different server than this process sits in.
_ns_write() {
    local s=${TMUX:-}
    s=${s%%,*}
    s=${s##*/}
    printf '%s' "${s:-default}"
}

_ns_read() {
    local s
    s=$("${TMUX_CMD[@]}" display -p '#{socket_path}' 2>/dev/null)
    s=${s##*/}
    printf '%s' "${s:-default}"
}

# The state option is window-scoped, but agents are per-pane and one window can
# hold several.
_win_state() {
    local mine=$1 sib ns
    [ "$mine" = waiting ] && { printf 'waiting'; return; }
    ns=$(_ns_write)
    for sib in $("${TMUX_CMD[@]}" list-panes -t "$TMUX_PANE" -F '#{pane_id}' 2>/dev/null); do
        [ "$sib" = "$TMUX_PANE" ] && continue
        if [ "$(cut -f1 "$STATE_DIR/$ns-${sib#%}" 2>/dev/null)" = waiting ]; then
            printf 'waiting'
            return
        fi
    done
    printf '%s' "$mine"
}

# Both `set` and `codex-notify` end here. State goes onto a tmux window option
# as well as into the state file: a `#(...)` in the window-list format forks
# once per window per status-interval tick, `#{@agent_state}` does not fork.
_publish() {
    local state=$1 msg=$2 proj=$3 tag=$4
    mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
    printf '%s\t%s\t%s\n' "$state" "${EPOCHSECONDS:-$(date +%s)}" "${msg:0:140}" \
        >"$STATE_DIR/$(_ns_write)-${TMUX_PANE#%}"
    "${TMUX_CMD[@]}" set -w -t "$TMUX_PANE" @agent_state "$(_win_state "$state")" 2>/dev/null
    "${TMUX_CMD[@]}" set -w -t "$TMUX_PANE" @agent_tag "$tag" 2>/dev/null
    proj=${proj%/}
    [ -n "$proj" ] && "${TMUX_CMD[@]}" set -w -t "$TMUX_PANE" @agent_project "${proj##*/}" 2>/dev/null
    # A hook must never report failure.
    exit 0
}

cmd_set() {
    local state=${1:-}
    [ -n "$state" ] || die "usage: tmux-agent set <running|waiting|idle|gone> [message]"

    if [ "$state" = gone ]; then
        rm -f "$STATE_DIR/$(_ns_write)-${TMUX_PANE#%}"
        # A sibling agent in the same window may still be blocked.
        local rest
        rest=$(_win_state idle)
        if [ "$rest" = waiting ]; then
            "${TMUX_CMD[@]}" set -w -t "$TMUX_PANE" @agent_state waiting 2>/dev/null
        else
            "${TMUX_CMD[@]}" set -uw -t "$TMUX_PANE" @agent_state 2>/dev/null
        fi
        exit 0
    fi
    local msg=${2:-}
    # A message is only read for waiting, the one state where the picker has to
    # show what is being asked. For running/idle the pane title covers it, and
    # UserPromptSubmit would dump the whole prompt into the row.
    #
    # Claude sends hook payloads as JSON on stdin. Cap the wait - a hook that
    # blocks hangs the agent.
    if [ "$state" = waiting ] && [ -z "$msg" ] && [ ! -t 0 ] && command -v jq >/dev/null 2>&1; then
        msg=$(timeout 0.2 cat 2>/dev/null | jq -r '.message // empty' 2>/dev/null | head -1)
    fi
    # Tabs and newlines would split the state file's three fields. Length is
    # _publish's job, so it is capped in exactly one place.
    msg=${msg//[$'\t\n']/ }

    # Claude fires Notification for two things: a permission request, and a
    # nudge once the prompt has sat idle a while. Only the first blocks you;
    # marking the nudge as blocked makes "!" cry wolf.
    case "$state=$msg" in
        waiting=*"waiting for your input"*) state=idle; msg='' ;;
    esac

    # CLAUDE_PROJECT_DIR beats the cwd basename when the agent is in a worktree
    # buried under .claude/worktrees/.
    _publish "$state" "$msg" "${CLAUDE_PROJECT_DIR:-$PWD}" "${TMUX_AGENT_TAG:-cc}"
}

# Codex's `notify` program, which is not one of its hooks: the payload arrives
# as a single JSON argv argument rather than on stdin, and there is exactly one
# event, agent-turn-complete. Turn-end is not a hook event, so this is the only
# way to hear it; running and waiting come from ~/.codex/hooks.json instead.
cmd_codex_notify() {
    local payload=${1:-}
    [ -n "$payload" ] || exit 0

    local kind='' msg='' cwd=''
    if command -v jq >/dev/null 2>&1; then
        # One field per line, not tab-separated: bash treats tab as IFS
        # whitespace, so an empty message would collapse and shift cwd into it.
        # Fenced code blocks are dropped so the prose survives, unless that is
        # all there was.
        local -a parts=()
        mapfile -t parts < <(
            printf '%s' "$payload" | jq -r '
                def strip_noise: gsub("[`*_#>]"; "") | gsub("\\s+"; " ")
                                 | ltrimstr(" ") | rtrimstr(" ");
                def prose:    gsub("```[\\s\\S]*?```"; " ") | strip_noise;
                def unfenced: gsub("```[a-zA-Z]*"; " ")     | strip_noise;
                (."last-assistant-message" // "") as $m
                | (($m | prose) as $p
                   | if ($p | length) > 0 then $p else ($m | unfenced) end) as $clean
                | .type // "", $clean, .cwd // ""' 2>/dev/null
        )
        kind=${parts[0]:-}
        msg=${parts[1]:-}
        cwd=${parts[2]:-}
    fi

    # Unknown event types are ignored rather than guessed at, so a future codex
    # release adding events cannot make this report a wrong state.
    case "$kind" in
        agent-turn-complete | '') ;;
        *) exit 0 ;;
    esac

    _publish idle "$msg" "${cwd:-$PWD}" "${TMUX_AGENT_TAG:-cx}"
}

# TSV: rank, pane, state, session:window, age, label, title, message. Unsorted;
# the rank column exists so that cmd_list can sort by urgency, and nothing else
# reads it.
_rows() {
    local now panes
    now=${EPOCHSECONDS:-$(date +%s)}
    panes=$("${TMUX_CMD[@]}" list-panes -a -F \
        '#{pane_id}	#{session_name}	#{window_index}	#{window_name}	#{pane_current_command}	#{pane_pid}	#{?@agent_tag,#{@agent_tag},-}	#{?@agent_project,#{@agent_project},-}	#{b:pane_current_path}	#{pane_title}' 2>/dev/null) || return 0
    [ -n "$panes" ] || return 0

    # One process scan, not one per pane. Marking both the pid and its parent
    # covers the two ways an agent gets launched: as the pane's own process, or
    # from a shell inside it - in which case the agent is the shell's child and
    # the pane pid is the parent we just recorded.
    local ns; ns=$(_ns_read)
    local -A agent_pid=()
    local p pp pargs
    while read -r p pp pargs; do
        [[ $pargs =~ $AGENT_ARGV_RE ]] || continue
        agent_pid[$p]=1
        agent_pid[$pp]=1
    done < <(ps -eo pid=,ppid=,args= 2>/dev/null)

    local pane sess widx wname cmd panepid tag proj cwdbase title file state ts msg rank age delta
    while IFS=$'\t' read -r pane sess widx wname cmd panepid tag proj cwdbase title; do
        [ -n "$pane" ] || continue

        file="$STATE_DIR/$ns-${pane#%}"
        state='' ts='' msg=''
        [ -r "$file" ] && IFS=$'\t' read -r state ts msg <"$file"

        # No hook has reported: keep the pane only if it looks like an agent,
        # by command name or by argv.
        if [ -z "$state" ] && ! [[ $cmd =~ $AGENT_RE ]] &&
            [ -z "${agent_pid[$panepid]:-}" ]; then
            continue
        fi

        [ "$tag" = - ] && tag=''
        [ "$proj" = - ] && proj=''

        case "$state" in
            waiting) rank=0 ;;
            running) rank=1 ;;
            idle)    rank=2 ;;
            *)       rank=3; state=${cmd:-unknown} ;;
        esac

        age=''
        if [ -n "$ts" ]; then
            delta=$((now - ts))
            if   [ "$delta" -lt 60 ];   then age="${delta}s"
            elif [ "$delta" -lt 3600 ]; then age="$((delta / 60))m"
            else age="$((delta / 3600))h$(((delta % 3600) / 60))m"
            fi
        fi

        # Agents set the terminal title to what they are working on, which tmux
        # exposes as pane_title. The leading spinner glyph stays: the picker
        # renders once, so it reads as a liveness hint. tmux.conf strips it for
        # the window name, where it would rewrite the name ~1.4x a second.
        title=${title//$'\t'/ }
        # Every row carries tag:project, so a claude row and a codex row read
        # the same way and you can see which checkout each agent is in.
        local label="${tag:+$tag:}${proj:-${cwdbase:-$wname}}"

        # Drop the title when it is not a task: codex puts the working directory
        # there, which the label already shows.
        [ "$title" = "$cwdbase" ] && title=''
        [ "$title" = "$proj" ] && title=''

        # `-` placeholders: tab is IFS whitespace, so an empty middle field
        # would collapse and shift every later value left.
        printf '%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$rank" "$pane" "$state" "$sess:$widx" "${age:--}" "$label" "${title:--}" "$msg"
    done <<<"$panes"
}

_glyph() {
    case "$1" in
        waiting) printf '\033[33m!\033[0m' ;;
        running) printf '\033[32m*\033[0m' ;;
        idle)    printf '\033[90m-\033[0m' ;;
        *)       printf '\033[90m?\033[0m' ;;
    esac
}

# Emits "pane<TAB>display" - fzf shows field 2+, and jumps using field 1.
cmd_list() {
    local rank pane state loc age label title msg desc
    _rows | sort -t$'\t' -k1,1n -k4,4 |
        while IFS=$'\t' read -r rank pane state loc age label title msg; do
            [ "$age" = - ] && age=''
            [ "$title" = - ] && title=''
            # Description runs to end of line: message length varies too much
            # for a fixed column. The label before it is padded, so it stays
            # aligned.
            desc=${title:0:60}
            [ -n "$msg" ] && desc="${desc:+$desc · }$msg"
            printf '%s\t%s %-7s %-5s %-16.16s %s\n' \
                "$pane" "$(_glyph "$state")" "$loc" "$age" "$label" "$desc"
        done
}

cmd_pick() {
    command -v fzf >/dev/null 2>&1 || die "fzf not found"

    [ $# -eq 0 ] || die "unknown flag: $1"

    # Shell-quoted for the fzf reload bind, which hands it to a shell.
    local list_str
    list_str=$(printf '%q ' "$SELF" list)

    local rows
    rows=$("$SELF" list)
    [ -n "$rows" ] || die "no agent panes found"

    # Preview stays unwrapped: a pane is captured at its own width, usually wider
    # than the preview window, so wrapping turns one captured line into two rows
    # and `tail -n $FZF_PREVIEW_LINES` overshoots past the bottom.
    local selection
    selection=$(printf '%s\n' "$rows" | fzf \
        --ansi \
        --delimiter=$'\t' \
        --with-nth=2.. \
        --no-multi \
        --preview "${TMUX_CMD[*]} capture-pane -p -e -S -200 -t {1} 2>/dev/null | tail -n \${FZF_PREVIEW_LINES:-40}" \
        --preview-window=right:65% \
        --header='enter jump   ctrl-r refresh   ctrl-/ wrap' \
        --bind 'ctrl-/:toggle-preview-wrap' \
        --bind "ctrl-r:reload($list_str)") || exit 130
    [ -n "$selection" ] || exit 130

    local pane
    pane=$(printf '%s' "$selection" | cut -f1)
    [ -n "$pane" ] || exit 130

    "${TMUX_CMD[@]}" select-window -t "$pane" 2>/dev/null
    "${TMUX_CMD[@]}" select-pane -t "$pane" 2>/dev/null
    if [ -n "${TMUX:-}" ]; then
        "${TMUX_CMD[@]}" switch-client -t "$pane"
    else
        "${TMUX_CMD[@]}" attach-session -t "$pane"
    fi
}

# Prints nothing unless something is waiting or running - a quiet status bar is
# the signal that nothing needs you.
cmd_summary() {
    local plain=0
    [ "${1:-}" = --plain ] && plain=1

    # Only a hook-reported pane can be waiting or running, so the state dir is
    # the whole input. With nothing reported this returns without asking tmux
    # anything, which is the common case on every status-interval tick.
    local ns; ns=$(_ns_read)
    local -a files=()
    local f
    for f in "$STATE_DIR/$ns-"*; do
        [ -f "$f" ] && files+=("$f")
    done
    [ "${#files[@]}" -gt 0 ] || return 0

    # Label by window index, not session: agents commonly share one session, and
    # the index is what a `select-window` keybind takes. Unattached sessions get
    # named too, since their index alone would mislead.
    #
    # The name half is the project, not the window name: window names carry the
    # agent's current task now, and a couple of those blow past
    # status-right-length and get the whole segment truncated mid-word.
    local -A label_of=()
    local pane sess widx wname attached
    while IFS=$'\t' read -r pane sess widx wname attached; do
        [ -n "$pane" ] || continue
        if [ "$attached" = 1 ]; then
            label_of[${pane#%}]="$widx:$wname"
        else
            label_of[${pane#%}]="$sess:$widx:$wname"
        fi
    done < <("${TMUX_CMD[@]}" list-panes -a \
        -F '#{pane_id}	#{session_name}	#{window_index}	#{?@agent_project,#{@agent_project},#{=/10/…:#{window_name}}}	#{session_attached}' 2>/dev/null)

    local -a waiting=()
    local running=0
    local id label state
    for f in "${files[@]}"; do
        id=${f##*/}; id=${id#"$ns-"}
        label=${label_of[$id]:-}
        [ -n "$label" ] || continue
        IFS=$'\t' read -r state _ <"$f"
        case "$state" in
            waiting) waiting+=("$label") ;;
            running) running=$((running + 1)) ;;
        esac
    done

    local out=''
    if [ "${#waiting[@]}" -gt 0 ]; then
        # Name at most two, then a count: this segment shares a hard width cap
        # with the clock and the current task, and an unbounded list of names
        # overruns it and gets the whole thing truncated mid-word. Deduped and
        # joined in-shell because awk|paste would be three forks a second.
        local -A seen=()
        local names='' n distinct=0
        for n in "${waiting[@]}"; do
            [ -n "${seen[$n]:-}" ] && continue
            seen[$n]=1
            distinct=$((distinct + 1))
            [ "$distinct" -le 2 ] && names="${names:+$names }$n"
        done
        [ "$distinct" -gt 2 ] && names="$names +$((distinct - 2))"
        # Count distinct labels, not panes: the names and the +N are per window,
        # so a pane count here would not reconcile with them.
        if [ "$plain" = 1 ]; then
            out="! $distinct waiting: $names"
        else
            out="#[fg=yellow,bold]! $distinct waiting: $names#[default]"
        fi
    fi
    if [ "$running" -gt 0 ]; then
        local run
        if [ "$plain" = 1 ]; then run="* $running"; else run="#[fg=green]* $running#[default]"; fi
        out="${out:+$out }$run"
    fi

    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}

cmd_clean() {
    [ -d "$STATE_DIR" ] || return 0
    # Only this server's namespace. Files belonging to another tmux server may
    # well be live, and this process has no way to ask that server about them.
    local ns
    ns=$(_ns_read)

    # One pass builds both maps: which pane ids still exist, and which windows
    # still hold a pane with state. Keys are session:index because a
    # #{window_id} "@" prefix collides with tmux's user-option syntax.
    local win pane
    local -A live_pane=() live_win=()
    while read -r win pane; do
        [ -n "$win" ] || continue
        live_pane[${pane#%}]=1
        [ -f "$STATE_DIR/$ns-${pane#%}" ] && live_win[$win]=1
    done < <("${TMUX_CMD[@]}" list-panes -a -F '#{session_name}:#{window_index} #{pane_id}' 2>/dev/null)

    local file id removed=0
    for file in "$STATE_DIR/$ns-"*; do
        [ -e "$file" ] || continue
        id=${file##*/}
        id=${id#"$ns-"}
        [ -n "${live_pane[$id]:-}" ] && continue
        rm -f "$file"
        removed=$((removed + 1))
    done

    # An agent killed without firing SessionEnd leaves its "!" behind, so drop
    # the marker on any window that no longer has a pane with state.
    local cleared=0
    while read -r win; do
        [ -n "$win" ] && [ -z "${live_win[$win]:-}" ] || continue
        [ -n "$("${TMUX_CMD[@]}" show -w -t "$win" @agent_state 2>/dev/null)" ] || continue
        "${TMUX_CMD[@]}" set -uw -t "$win" @agent_state 2>/dev/null
        cleared=$((cleared + 1))
    done < <("${TMUX_CMD[@]}" list-windows -a -F '#{session_name}:#{window_index}' 2>/dev/null)

    printf 'removed %d stale entr%s, cleared %d stale marker%s\n' \
        "$removed" "$([ "$removed" = 1 ] && echo y || echo ies)" \
        "$cleared" "$([ "$cleared" = 1 ] || echo s)"
}

[ $# -eq 0 ] && set -- pick

# Only the hook entry points need a pane to key on; the other commands ask tmux
# over TMUX_CMD and work from outside it. Bail quietly rather than erroring - a
# hook must never fail the agent it reports on.
case "$1" in
    set | codex-notify) [ -n "${TMUX_PANE:-}" ] || exit 0 ;;
esac

case "$1" in
    set)          shift; cmd_set "$@" ;;
    codex-notify) shift; cmd_codex_notify "$@" ;;
    pick)    shift; cmd_pick "$@" ;;
    list)    shift; cmd_list "$@" ;;
    summary) shift; cmd_summary "$@" ;;
    clean)   shift; cmd_clean "$@" ;;
    -h|--help|help)
        awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$SELF"
        ;;
    *) die "unknown command: $1 (try --help)" ;;
esac
